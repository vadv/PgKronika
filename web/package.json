{
  "name": "pgkronika-web-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "codegen": "openapi-typescript ../bins/pg_kronika-web/openapi/openapi.yaml -o src/api/schema.d.ts",
    "spec:lint": "spectral lint ../target/pg-kronika-openapi.yaml --ruleset ../.spectral.yaml",
    "demo:stub": "node scripts/demo-stub.mjs",
    "demo:shot": "node scripts/demo-shot.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "openapi-fetch": "0.17.0",
    "openapi-typescript-helpers": "0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.16.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "puppeteer-core": "^25.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
